# Hylé configuration. Copy to .env and adjust. docker compose reads this file.
# ---------------------------------------------------------------------------
# LOCAL TEST (defaults — you can leave .env empty and just `docker compose up`)
# ---------------------------------------------------------------------------
# Public URL of the registry API (what web + CLI call).
HYLE_REGISTRY_URL=http://localhost:3000
# Public URL of the web UI (also the CORS origin allowed by the registry).
HYLE_WEB_URL=http://localhost:8080
# Host port mappings.
REGISTRY_PORT=3000
WEB_PORT=8080
# Auth: none = local/dev, no SSO, publish trusts the manifest author.
HYLE_AUTH_PROVIDER=none

# ---------------------------------------------------------------------------
# DEPLOY (staging / pre-prod / prod / on-prem / cloud)
# Use with: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# ---------------------------------------------------------------------------
# HYLE_REGISTRY_URL=https://registry.staging.example.com
# HYLE_WEB_URL=https://hyle.staging.example.com
#
# Sign JWTs — REQUIRED when auth is enabled. Generate: openssl rand -hex 32
# JWT_SECRET=
#
# --- Option A: GitHub OAuth ---
# HYLE_AUTH_PROVIDER=github
# HYLE_AUTH_CLIENT_ID=
# HYLE_AUTH_CLIENT_SECRET=
#
# --- Option B: Generic OAuth2 / OIDC (GitLab, Bitbucket, Keycloak, Okta, ...) ---
# HYLE_AUTH_PROVIDER=oauth2
# HYLE_AUTH_CLIENT_ID=
# HYLE_AUTH_CLIENT_SECRET=
# HYLE_AUTH_AUTHORIZE_URL=https://gitlab.example.com/oauth/authorize
# HYLE_AUTH_TOKEN_URL=https://gitlab.example.com/oauth/token
# HYLE_AUTH_USERINFO_URL=https://gitlab.example.com/api/v4/user
# Field mapping from the provider's userinfo JSON (defaults shown are OIDC-style):
# HYLE_AUTH_ID_FIELD=sub
# HYLE_AUTH_LOGIN_FIELD=preferred_username
# HYLE_AUTH_EMAIL_FIELD=email
# HYLE_AUTH_AVATAR_FIELD=picture
